# --- nhost / Hasura connection (client-side, public) ---
NEXT_PUBLIC_NHOST_SUBDOMAIN=your-nhost-subdomain
NEXT_PUBLIC_NHOST_REGION=eu-central-1

# --- server-only secrets, never exposed to the browser ---
# Used by lib/hasura-admin.ts to run privileged queries/mutations from the
# Action-handler API routes (role re-checks, writes to workflow_runs/step_runs).
HASURA_GRAPHQL_ADMIN_SECRET=changeme
HASURA_GRAPHQL_GRAPHQL_URL=https://your-nhost-subdomain.hasura.eu-central-1.nhost.run/v1/graphql

# Shared secret Hasura sends back on Action/event-trigger/cron webhook calls;
# routes verify the `x-webhook-secret` header equals this before doing anything.
ACTION_WEBHOOK_SECRET=changeme
EVENT_WEBHOOK_SECRET=changeme

# Base URL this app is deployed at, so Hasura metadata (actions/event
# triggers/cron) knows where to send webhooks.
ACTION_BASE_URL=http://localhost:3000

# --- LLM provider for llm_call steps ---
# If GROQ_API_KEY is unset, llm_call steps fall back to a stubbed response
# with a 1.5s artificial delay (see lib/workflow-executor.ts) so the rest of
# the pipeline is fully demoable without an API key.
GROQ_API_KEY=

# --- optional: real Slack delivery for notify steps ---
# If unset, /api/notify-webhook logs a clearly-marked simulated message
# instead of making a network call.
SLACK_WEBHOOK_URL=
